# SubsTracker 环境变量配置（复制为 .env 或直接写进 docker-compose）
# 服务监听
PORT=3000
HOST=0.0.0.0

# 数据目录（务必挂载持久化）
DATA_DIR=./data

# 定时提醒（5 段式 cron，服务器本地时区），多个任务用分号分隔
# 示例：每天早上 8 点 = 0 8 * * *   每小时 = 0 * * * *
CRON=0 8 * * *

# 时区（Docker 内建议写 Asia/Shanghai）
TZ=Asia/Shanghai

# iOS「添加到主屏幕」PWA 支持（1 开启 / 0 关闭）
PWA_INJECT=1
